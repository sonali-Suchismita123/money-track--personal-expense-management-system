# MoneyTrack Environment Configuration Template
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-random-secret-key-here

# Neon Serverless PostgreSQL Database Connection
# Replace with your Neon connection string:
DATABASE_URL=postgresql://<username>:<password>@<ep-hostname>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# Frontend URL
FRONTEND_URL=http://localhost:3000
